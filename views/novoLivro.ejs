<%- include('partials/header') %>

<section class="max-w-lg mx-auto bg-white rounded-lg shadow p-6" aria-labelledby="titulo-form">
  <h2 id="titulo-form" class="text-2xl font-bold text-emerald-700 mb-6">Cadastrar Novo Livro</h2>

  <form action="/livros/novo" method="POST">
    <fieldset class="border-0">
      <legend class="sr-only">Dados do Livro</legend>

      <div class="mb-4">
        <label for="titulo" class="block text-sm font-medium text-gray-700 mb-1">Título do Livro</label>
        <input type="text" id="titulo" name="titulo" required
               class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-emerald-500"
               placeholder="Ex: Dom Casmurro" />
      </div>

      <div class="mb-4">
        <label for="autor" class="block text-sm font-medium text-gray-700 mb-1">Autor</label>
        <input type="text" id="autor" name="autor" required
               class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-emerald-500"
               placeholder="Ex: Machado de Assis" />
      </div>

      <div class="mb-6">
        <label for="paginas" class="block text-sm font-medium text-gray-700 mb-1">Quantidade de Páginas</label>
        <input type="number" id="paginas" name="paginas" min="1" required
               class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-emerald-500"
               placeholder="Ex: 256" />
      </div>
    </fieldset>

    <menu class="flex gap-3 p-0 m-0">
      <li>
        <button type="submit"
                class="bg-emerald-600 hover:bg-emerald-700 text-white font-semibold px-5 py-2 rounded-lg shadow transition">
          Salvar Livro
        </button>
      </li>
      <li>
        <a href="/livros"
           class="inline-block bg-gray-200 hover:bg-gray-300 text-gray-700 font-semibold px-5 py-2 rounded-lg shadow transition">
          Cancelar
        </a>
      </li>
    </menu>
  </form>
</section>

<%- include('partials/footer') %>
